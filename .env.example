# Vercel and local Next server: Clerk publishable key (intentionally public).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Vercel and local Next server: Clerk server authentication.
CLERK_SECRET_KEY=

# Vercel and local Next server: target Convex client URL (HTTPS .convex.cloud; public).
NEXT_PUBLIC_CONVEX_URL=

# Vercel and local Next server: same deployment's HTTP Actions URL (HTTPS .convex.site; server-only).
CONVEX_HTTP_URL=

# Convex dashboard for each deployment: Clerk JWT issuer domain.
CLERK_JWT_ISSUER_DOMAIN=

# Convex dashboard AND Vercel/local Next server: identical bridge credential per environment.
INNGEST_BRIDGE_SECRET=

# Convex dashboard for each deployment: required only for the retained email action.
RESEND_API_KEY=

# Vercel and local Next server: required only for the retained monthly insights job.
GEMINI_API_KEY=

# Vercel production (and served preview if enabled): Inngest request verification.
INNGEST_SIGNING_KEY=

# Vercel/local Next server: optional Inngest publishing key; no application event publishing today.
INNGEST_EVENT_KEY=

# Local Convex CLI configuration: deployment selection; not a runtime Vercel variable.
CONVEX_DEPLOYMENT=
