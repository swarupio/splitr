# Public Clerk publishable key; Vercel/local; intentionally included in the client bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public Convex .convex.cloud deployment URL; Vercel/local; intentionally client-visible.
NEXT_PUBLIC_CONVEX_URL=

# Clerk server authentication key; Vercel/local only; never client-visible.
CLERK_SECRET_KEY=

# Clerk JWT issuer domain; Convex deployment only; matches the existing Clerk JWT template.
CLERK_JWT_ISSUER_DOMAIN=

# Shared Inngest HTTP bridge credential; identical in Vercel/local and Convex; server-only.
INNGEST_BRIDGE_SECRET=

# Production Inngest request-signing credential; Vercel/local server only.
INNGEST_SIGNING_KEY=

# Optional Inngest event publishing credential; no application events currently sent; server-only.
INNGEST_EVENT_KEY=

# Monthly-insights Gemini credential; Vercel/local server only; not needed for the UI.
GEMINI_API_KEY=

# Required for email sending; MUST be set in each Convex deployment, not just locally or in Vercel; server-only.
RESEND_API_KEY=

# Local Convex CLI deployment selector; tooling only, not a client variable or runtime secret.
CONVEX_DEPLOYMENT=
